# -----------------------------------------------------------------------------
# Global app settings
# -----------------------------------------------------------------------------
RAILS_ENV=development
RAILS_LOG_LEVEL=debug
RAILS_MAX_THREADS=5
DB_POOL=5

# App host and port
HOST=localhost
PORT=3000
APP_HOST=localhost:3000

# Monitoring
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# Redis
REDIS_URL=redis://127.0.0.1:6379/0

# -----------------------------------------------------------------------------
# Shared database defaults
# Used when an environment-specific DATABASE_URL is not set
# -----------------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres

# -----------------------------------------------------------------------------
# Development
# -----------------------------------------------------------------------------
DEVELOPMENT_DB_NAME=rocketpass_starterpack_rails_development
# DEVELOPMENT_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/rocketpass_starterpack_rails_development

# -----------------------------------------------------------------------------
# Test
# -----------------------------------------------------------------------------
TEST_DB_NAME=rocketpass_starterpack_rails_test
# TEST_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/rocketpass_starterpack_rails_test

# -----------------------------------------------------------------------------
# Staging
# Prefer URL-based config in staging
# -----------------------------------------------------------------------------
STAGING_DB_NAME=rocketpass_starterpack_rails_staging
# STAGING_DATABASE_URL=postgres://app:password@staging-db-host:5432/rocketpass_starterpack_rails_staging

# -----------------------------------------------------------------------------
# Production
# Prefer URL-based config in production
# -----------------------------------------------------------------------------
PRODUCTION_DB_NAME=rocketpass_starterpack_rails_production
# PRODUCTION_DATABASE_URL=postgres://app:password@prod-db-host:5432/rocketpass_starterpack_rails_production

# Optional separate Action Cable database
PRODUCTION_CABLE_DB_NAME=rocketpass_starterpack_rails_production_cable
# PRODUCTION_CABLE_DATABASE_URL=postgres://app:password@prod-db-host:5432/rocketpass_starterpack_rails_production_cable

# -----------------------------------------------------------------------------
# Deploy / registry
# -----------------------------------------------------------------------------
KAMAL_REGISTRY_PASSWORD=

# -----------------------------------------------------------------------------
# AWS S3 (optional)
# -----------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=

# -----------------------------------------------------------------------------
# OAuth / misc
# -----------------------------------------------------------------------------
# OAUTH_REDIRECT_URI=http://localhost:3000/oauth/callback
# RAILS_MASTER_KEY=copy-from-config-master-key-for-deploy-only
